{
  "name": "subs",
  "description": "Track your subscriptions easily",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --bun vite dev --port 5173 --host 0.0.0.0",
    "build": "bun run build:server && bun run build:demo",
    "build:server": "bun --bun vite build",
    "build:demo": "bun --bun vite build --config vite.demo.config.ts",
    "dev:demo": "bun --bun vite --config vite.demo.config.ts --host 127.0.0.1 --port 5174",
    "preview:demo": "bun --bun vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 4174",
    "deploy:demo": "wrangler deploy --config wrangler.demo.jsonc",
    "start": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts demo vite.config.ts vite.demo.config.ts playwright.config.ts tsconfig.json components.json package.json biome.json wrangler.demo.jsonc",
    "format": "biome format --write src tests scripts demo vite.config.ts vite.demo.config.ts playwright.config.ts tsconfig.json components.json package.json biome.json wrangler.demo.jsonc",
    "check": "bun run lint && bun run typecheck",
    "test": "playwright test",
    "reset-pin": "bun scripts/reset-pin.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "latest",
    "db0": "latest",
    "framer-motion": "14.3.0",
    "input-otp": "latest",
    "motion-dom": "14.3.0",
    "motion-utils": "14.1.1",
    "next-themes": "latest",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "latest",
    "sonner": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4",
    "@types/bun": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "lefthook": "latest",
    "pathe": "^2.0.3",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8",
    "wrangler": "4.151.1"
  }
}
